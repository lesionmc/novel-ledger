# novel-ledger 本地配置模板
# 用法：复制本文件为 .env，填入你的 key。.env 已被 .gitignore 排除，绝不入库。

# 兼容任意 OpenAI 兼容厂商：换厂商只需改下面三行。
# 本仓库实测主力：Agnes AI 全模态（注册送免费额度，flash 系便宜快稳）
#   API 文档：https://www.agnes-ai.com/zh-Hans/docs/overview

# ── 例 1：Agnes AI ─────────────────────────────────────────────
AGNES_API_KEY=sk-你的key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1/
AGNES_MODEL=agnes-2.5-flash

# ── 例 2：智谱 GLM（注释掉上面三行后启用）──────────────────────
# AGNES_API_KEY=你的智谱key
# AGNES_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# AGNES_MODEL=glm-4.5-flash

# ── 例 3：DeepSeek ──────────────────────────────────────────────
# AGNES_API_KEY=你的deepseekkey
# AGNES_BASE_URL=https://api.deepseek.com/v1/
# AGNES_MODEL=deepseek-chat

# ── 备用模型（可选）：主模型连续失败后自动切换，防单点故障 ──────
# 两个引擎的主流程都会自动生效；只配 KEY+MODEL 即可（URL 缺省沿用主通道）
# FALLBACK_API_KEY=备用key
# FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# FALLBACK_MODEL=glm-4.5-flash
