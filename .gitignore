# 本地密钥与配置，绝不入库
.env
*.env
!*.env.example

# 模型用量流水（R48，本机数据）
usage_log.jsonl

# 章快照底账（R47，本机数据，随 R34 备份打包）
**/_snapshots/

# 一键备份产物（R34，本机数据）
backups/

# React 工作台（A′）：依赖与中间产物不入库；构建产物 web/ui/ 随仓库分发
web/ui-src/node_modules/
web/ui-src/dist/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 用户书稿数据（本地私有）：章节正文与一切机器产物不入库
**/chapters/
*.bak.md
books/*/versions/

# 系统
.DS_Store
Thumbs.db

# 归档物（残留测试书/旧版备份/损坏账本留档）不入版本库
books/_archive/
**/_archive/
